{
  "name": "dsh-plugin-practice",
  "version": "0.1.0",
  "description": "Practice bundle for learning DeepSeek Harness plugin development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./plugin": "./lib/plugin.js",
    "./workspace-info": "./lib/workspace-info.js",
    "./configurable-greet": "./lib/configurable-greet.js",
    "./workspace-name-service": "./lib/workspace-name-service.js",
    "./workspace-name-tool": "./lib/workspace-name-tool.js",
    "./workspace-event-contract": "./lib/workspace-event-contract.js",
    "./workspace-event-emitter": "./lib/workspace-event-emitter.js",
    "./workspace-event-listener": "./lib/workspace-event-listener.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "scripts/deploy.mjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-plugin-practice": "./scripts/deploy.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "prepare": "tsdown --config tsdown.config.ts",
    "pack:plugin": "node ./scripts/deploy.mjs --pack-only",
    "deploy": "node ./scripts/deploy.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ri0n72Y/dsh-plugin-practice.git"
  },
  "license": "MIT"
}
